<?xml version="1.0"?>
<!-- 1-DOF fixed-base revolute pendulum with a TIGHT joint limit (±0.4 rad) for
     verifying AffineBodyRevoluteJointLimit in ipc_monolithic mode. Link points +z;
     under gravity it is driven into the limit. -->
<robot name="m5_pendulum">
  <link name="base">
    <inertial>
      <origin xyz="0 0 0.04"/>
      <mass value="3.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.04"/>
      <geometry><box size="0.12 0.12 0.08"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.04"/>
      <geometry><box size="0.12 0.12 0.08"/></geometry>
    </visual>
  </link>

  <link name="link1">
    <inertial>
      <origin xyz="0 0 0.20"/>
      <mass value="0.8"/>
      <inertia ixx="0.012" iyy="0.012" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.20"/>
      <geometry><box size="0.05 0.05 0.40"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.20"/>
      <geometry><box size="0.05 0.05 0.40"/></geometry>
    </visual>
  </link>

  <joint name="j1" type="revolute">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.08"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.4" upper="0.4" effort="100" velocity="10"/>
  </joint>
</robot>
