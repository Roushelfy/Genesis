<?xml version="1.0"?>
<!-- Minimal fixed-base 2-DOF revolute arm fixture for the ipc_monolithic M2 smoke.
     Box collision geoms (watertight -> AffineBodyConstitution). -->
<robot name="m2_arm">
  <link name="base">
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="2.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.12 0.12 0.10"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.12 0.12 0.10"/></geometry>
    </visual>
  </link>

  <link name="link1">
    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="0.6"/>
      <inertia ixx="0.005" iyy="0.005" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry><box size="0.05 0.05 0.30"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry><box size="0.05 0.05 0.30"/></geometry>
    </visual>
  </link>

  <link name="link2">
    <inertial>
      <origin xyz="0 0 0.125"/>
      <mass value="0.4"/>
      <inertia ixx="0.003" iyy="0.003" izz="0.0008" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.125"/>
      <geometry><box size="0.04 0.04 0.25"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.125"/>
      <geometry><box size="0.04 0.04 0.25"/></geometry>
    </visual>
  </link>

  <joint name="j1" type="revolute">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.10"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.0" upper="3.0" effort="100" velocity="10"/>
  </joint>

  <joint name="j2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.30"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.0" upper="3.0" effort="100" velocity="10"/>
  </joint>
</robot>
