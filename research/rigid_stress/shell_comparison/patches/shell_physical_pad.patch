+@pytest.mark.required
+@pytest.mark.parametrize("precision", ["64"])
+@pytest.mark.parametrize("n_envs", [0, 2])
+@pytest.mark.parametrize("dt", [1e-3, 2e-3])
+@pytest.mark.use_deterministic_algorithms(False)
+def test_physical_pad_compliance(n_envs, dt, grid_sheet_path, asset_tmp_path, show_viewer):
+    size, thickness, density, gravity, stiffness = 0.15, 0.002, 1000.0, 9.81, 1e6
+    path = grid_sheet_path(4, 4, size, size)
+    mesh = trimesh.load(path, process=False)
+    corners = mesh.vertices[mesh.faces]
+    area = np.linalg.norm(np.cross(corners[:, 1] - corners[:, 0], corners[:, 2] - corners[:, 0]), axis=1) / 2
+    geometry = asset_tmp_path / "physical-pad.npz"
+    np.savez_compressed(
+        geometry,
+        corners_m=corners,
+        points_m=corners.mean(axis=1),
+        projected_area_m2=area,
+        jacobians=np.broadcast_to(np.eye(3) / 3, (len(corners), 3, 3, 3)),
+    )
+    scene = gs.Scene(
+        sim_options=gs.options.SimOptions(dt=dt, gravity=(0.0, 0.0, -gravity)),
+        shell_options=gs.options.ShellOptions(
+            contact_pad_stiffness=stiffness,
+            contact_pad_geometry=str(geometry),
+            pcg_tolerance=1e-6,
+            pcg_velocity_tolerance=1e-10,
+            n_coarse_patches=0,
+        ),
+        show_viewer=show_viewer,
+    )
+    plane = scene.add_entity(morph=gs.morphs.Plane(), material=gs.materials.Rigid(coup_friction=0.0))
+    sheet = scene.add_entity(
+        morph=gs.morphs.Mesh(file=path, decimate=False),
+        material=gs.materials.Shell(rho=density, E=1e6, thickness=thickness, damping=0),
+    )
+    scene.build(n_envs=n_envs)
+    for _ in range(160):
+        scene.step()
+    compression = density * thickness * gravity / stiffness
+    assert_allclose(sheet.get_verts_pos()[..., 2], -compression, atol=1e-8)
+    assert_allclose(sheet.get_verts_vel(), 0, atol=1e-7)
+    contact = tensor_to_array(sheet.get_verts_contact_force()).sum(axis=-2)
+    assert_allclose(contact[..., 2], density * thickness * size**2 * gravity, rtol=1e-5)
+    assert_allclose(contact[..., :2], 0, atol=1e-10)
+    ground = tensor_to_array(plane.get_links_net_contact_force()).sum(axis=-2)
+    assert_allclose(ground + contact, 0, atol=1e-10)
+    assert_equal(scene.sim.shell_solver.get_envs_solver_failure(), 0)
+
+
