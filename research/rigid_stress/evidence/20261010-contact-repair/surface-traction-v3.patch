+def func_coulomb(vector: qd.types.vector(3), normal: qd.types.vector(3), friction: float):
+    compression = vector.dot(normal)
+    tangent = vector - compression * normal
+    magnitude = tangent.norm()
+    projected = qd.Vector.zero(gs.qd_float, 3)
+    derivative = qd.Matrix.zero(gs.qd_float, 3, 3)
+    if compression >= 0.0 and magnitude <= friction * compression:
+        projected = vector
+        derivative = qd.Matrix.identity(gs.qd_float, 3)
+    elif compression + friction * magnitude > 0.0:
+        direction = tangent / magnitude
+        pressure = (compression + friction * magnitude) / (1.0 + friction * friction)
+        generator = normal + friction * direction
+        projected = pressure * generator
+        derivative = generator.outer_product(generator) / (1.0 + friction * friction)
+        derivative += (
+            friction
+            * pressure
+            / magnitude
+            * (qd.Matrix.identity(gs.qd_float, 3) - normal.outer_product(normal) - direction.outer_product(direction))
         )
-        coefficient /= weight_sum
-    status = 0 if accepted else (5 if nonsingular else 3)
-    return coefficient, weight_sum, status
+    return projected, derivative
+
+
+@qd.func
+def func_traction_sample(
+    i_q: int,
+    center: qd.types.vector(3),
+    radius: float,
+    surface_info: StressSurfaceInfo,
+):
+    relative = (surface_info.positions[i_q] - center) / radius
+    distance = relative.dot(relative)
+    weight = gs.qd_float(0.0)
+    if distance < 1.0:
+        weight = qd.exp(-0.5 * distance / (0.45 * 0.45)) * (1.0 - distance) ** 2 * surface_info.weights[i_q]
+    operator = qd.Matrix.zero(gs.qd_float, 6, 3)
+    for i in qd.static(range(3)):
+        operator[i, i] = 1.0
+    operator[3, 1], operator[3, 2] = -relative[2], relative[1]
+    operator[4, 0], operator[4, 2] = relative[2], -relative[0]
+    operator[5, 0], operator[5, 1] = -relative[1], relative[0]
+    return operator, weight
+
+
+@qd.func
+def func_solve_traction(gram: qd.types.matrix(6, 6), right: qd.types.vector(6)):
+    # Positive diagonal regularization retains descent when active cone directions lose rank.
+    regularization = 1e-12 * qd.max(gram.trace() / 6.0, 1e-6)
+    diagonal = qd.Vector.zero(gs.qd_float, 6)
+    factor = qd.Matrix.zero(gs.qd_float, 6, 6)
+    value = qd.Vector.zero(gs.qd_float, 6)
+    for i in range(6):
+        pivot = gram[i, i] + regularization
+        for j in range(i):
+            pivot -= factor[i, j] * factor[i, j] * diagonal[j]
+        diagonal[i] = qd.max(pivot, regularization)
+        for j in range(i + 1, 6):
+            entry = gram[j, i]
+            for k in range(i):
+                entry -= factor[j, k] * factor[i, k] * diagonal[k]
+            factor[j, i] = entry / diagonal[i]
+        value[i] = right[i]
+        for j in range(i):
+            value[i] -= factor[i, j] * value[j]
+    for i in range(6):
+        value[i] /= diagonal[i]
+    for k in range(6):
+        i = 5 - k
+        for j in range(i + 1, 6):
+            value[i] -= factor[j, i] * value[j]
+    return value
 
 
