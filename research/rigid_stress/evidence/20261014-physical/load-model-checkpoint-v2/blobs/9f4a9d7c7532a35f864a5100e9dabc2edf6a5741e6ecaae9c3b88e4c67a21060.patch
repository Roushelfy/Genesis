+        snapshot = {
+            "mesh_sha256": hashlib.sha256(args.mesh.read_bytes()).hexdigest(),
+            "geometry": args.geometry,
+            "case": case,
+            "material": {"young_Pa": 1e10, "poisson": 0.3, "density_kg_m3": 2000},
+            "mass_kg": float(reference.total_mass),
+            "com_m": reference.com.tolist(),
