+    )
+    for _ in range(args.steps):
+        workload.step()
+    workload.scene.rigid_solver.check_errno()
+    if workload.stress:
+        print("Maximum VM stress, Pa:", tensor_to_array(workload.link.get_max_stress()))
+
+
+if __name__ == "__main__":
+    main()
