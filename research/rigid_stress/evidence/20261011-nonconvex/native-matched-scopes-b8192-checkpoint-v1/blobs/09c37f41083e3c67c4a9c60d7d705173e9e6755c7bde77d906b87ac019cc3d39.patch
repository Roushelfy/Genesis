+#!/usr/bin/env bash
+set -euo pipefail
+cd /mnt/home/zhaofeng/workspace/Genesis/.worktrees/rigid-stress-recovery
+source research/rigid_stress/scripts/cluster_env.sh
+task_batch=${1:?Batch required}
+task_seed=${2:?Seed required}
+task_root="$RIGID_STRESS_DATA_ROOT/runs/20261011-nonconvex"
+task_bank="$task_root/native-matched-scopes-v1/b${task_batch}-${task_seed}/conditions.npz"
+for task_scope in rigid recovery live policy; do
+    task_run="$task_root/native-matched-scopes-v1/b${task_batch}-${task_seed}/${task_scope}"
+    test ! -e "$task_run"
+    mkdir -p "$task_run/tmp" "$task_run/source"
+    export TMPDIR="$task_run/tmp" PYTHONUNBUFFERED=1
+    export QD_OFFLINE_CACHE_FILE_PATH="$task_run/cache/quadrants" GS_CACHE_FILE_PATH="$task_run/cache/genesis"
+    task_sources=(genesis/engine/solvers/rigid/stress/*.py genesis/engine/solvers/rigid/collider/*.py genesis/options/{rigid_stress,morphs}.py genesis/utils/{array_class,misc}.py examples/rigid/{franka_egg_stress,egg_stress_controller}.py examples/speed_benchmark/rigid_stress{,_metrics}.py examples/rigid/assets/hollow_egg/level1/elastic.npz "$task_root/run_native_matched_scopes_v1.sh")
+    sha256sum "${task_sources[@]}" > "$task_run/source.sha256"
+    cp --parents "${task_sources[@]}" "$task_run/source"
+    git diff HEAD > "$task_run/source.patch"
+    hostname > "$task_run/node.txt"
+    nvidia-smi --query-gpu=name,memory.total,driver_version,uuid --format=csv > "$task_run/hardware.csv"
+    task_args=(--conditions "$task_bank")
+    if [[ "$task_scope" == rigid ]]; then
+        task_args=(--save-conditions "$task_bank")
+    else
+        sha256sum "$task_bank" > "$task_run/conditions-before.sha256"
+    fi
+    if [[ "$task_scope" != recovery ]]; then task_args+=(--trajectory-metrics); fi
