+        j_gb = i_gb
+        ja_pos = ga_pos
+        ja_quat = ga_quat
+        jb_pos = gb_pos
+        jb_quat = gb_quat
+        phase_sign = gs.qd_float(1.0)
+        if qd.static(i_phase == 1):
