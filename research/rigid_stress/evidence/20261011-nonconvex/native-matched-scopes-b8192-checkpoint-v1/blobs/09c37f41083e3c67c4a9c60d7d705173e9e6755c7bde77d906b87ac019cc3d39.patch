+                    if scale_arr.size == 3:
+                        self.scale = (scale_arr[0], scale_arr[2], scale_arr[1])
+            self.file_meshes_are_zup = False
+        elif self.file_meshes_are_zup is None:
+            self.file_meshes_are_zup = True
+
+        return self
