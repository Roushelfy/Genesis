+    def _identifier(self) -> str:
+        if isinstance(self.file, str):
+            try:
+                return uu.get_robot_name(self.file)
+            except (ValueError, ET.ParseError, FileNotFoundError, OSError):
+                pass
+        return super()._identifier()
+
