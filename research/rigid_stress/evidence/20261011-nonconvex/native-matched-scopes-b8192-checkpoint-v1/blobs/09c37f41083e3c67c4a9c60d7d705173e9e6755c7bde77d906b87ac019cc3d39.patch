+def kernel_scatter_tractions(
+    contact_state: StressContactState,
+    traction_state: StressTractionState,
+    state: StressState,
+    stress_info: StressInfo,
+    surface_info: StressSurfaceInfo,
+    traction_info: StressTractionInfo,
+    errno: qd.Tensor,
+    reset_force: bool,
+    cooperative: bool = True,
+):
