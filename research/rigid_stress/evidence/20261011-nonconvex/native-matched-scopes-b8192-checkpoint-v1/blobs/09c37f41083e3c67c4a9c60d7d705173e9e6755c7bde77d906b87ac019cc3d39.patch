+                        )
+                        grad_norm = grad_v.norm()
+                        pen_emit = gs.qd_float(0.0)
+                        is_support = False
+                        if grad_norm > 0.9:
+                            if pen_v > 0.0:
+                                pen_emit = pen_v
+                            elif qd.static(i_phase == 0):
