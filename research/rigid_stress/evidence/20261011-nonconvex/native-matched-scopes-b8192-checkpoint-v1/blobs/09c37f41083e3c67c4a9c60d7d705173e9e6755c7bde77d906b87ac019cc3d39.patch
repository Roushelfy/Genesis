+                                                + allowance,
+                                            )
+                                if i_check == 0:
+                                    if depth > 128.0 * epsilon:
+                                        adjusted[0:3] -= qd.max(maximum + 1e-12, 0.0) / depth * reference
+                                    if adjusted.norm() > 0.0:
