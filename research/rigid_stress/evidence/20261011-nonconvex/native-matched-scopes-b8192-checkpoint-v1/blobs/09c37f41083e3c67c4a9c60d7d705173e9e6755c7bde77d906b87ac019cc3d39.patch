+                        u_x = axis_x - axis_dot_normal * mean_normal_x
+                        u_y = axis_y - axis_dot_normal * mean_normal_y
+                        u_z = axis_z - axis_dot_normal * mean_normal_z
+                        u_norm = qd.sqrt(u_x * u_x + u_y * u_y + u_z * u_z)
