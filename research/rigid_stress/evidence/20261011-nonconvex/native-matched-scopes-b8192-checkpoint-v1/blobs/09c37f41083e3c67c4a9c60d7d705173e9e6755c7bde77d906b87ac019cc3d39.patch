+            j_gb = i_ga
+            ja_pos = gb_pos
+            ja_quat = gb_quat
+            jb_pos = ga_pos
+            jb_quat = ga_quat
+            phase_sign = -1.0
+        is_phase_active = True
+        if qd.static(i_phase == 1):
