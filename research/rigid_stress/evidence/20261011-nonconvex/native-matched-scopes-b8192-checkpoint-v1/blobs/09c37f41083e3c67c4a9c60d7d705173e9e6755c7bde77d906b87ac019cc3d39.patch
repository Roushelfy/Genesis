+    for i, left in enumerate(terms):
+        for j, right in enumerate(terms):
+            for a, alpha in left:
+                for b, beta in right:
+                    exponent = alpha + beta
+                    result[i, j] += (
+                        a * b * 6 * prod(factorial(int(k)) for k in exponent) / factorial(3 + int(exponent.sum()))
