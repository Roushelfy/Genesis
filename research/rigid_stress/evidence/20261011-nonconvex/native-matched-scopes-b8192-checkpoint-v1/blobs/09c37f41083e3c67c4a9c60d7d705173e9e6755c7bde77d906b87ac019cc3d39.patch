+"""Native finite profiles reached through actual material-boundary paths."""
+
+from dataclasses import dataclass
+from enum import IntEnum
+from typing import ClassVar
+
+import quadrants as qd
+
+import genesis as gs
+from genesis.utils.array_class import DataKind, V
+
+from .contact import StressContactState
+from .data import StressInfo
+from .paths import StressPathInfo, func_surface_segment
+from .provenance import StressSourceState, StressSourceStatus, func_closest_triangle
+from .surface import StressSurfaceInfo
+from .traction import (
+    StressTractionInfo,
+    StressTractionState,
+    StressTractionStatus,
+    create_tractions,
+    func_circle_panel,
+    func_surface_fan_bary,
+    func_traction_support_range,
+)
+
+
+class StressFootprintStatus(IntEnum):
+    SUCCESS = 0
+    INVALID_SOURCE = 1
+    INVALID_INPUT = 2
+    EMPTY_SUPPORT = 3
+
+
+@dataclass(frozen=True)
+class StressFootprintState:
+    kind: ClassVar[DataKind] = DataKind.SCRATCH
+
+    port_distance: qd.Tensor
+    seed_distance: qd.Tensor
+    status: qd.Tensor
+    candidates: qd.Tensor
+    samples: qd.Tensor
+    maximum_distance: qd.Tensor
+
+
+def create_footprints(
+    n_ports: int, n_contacts: int, n_envs: int, n_face_ports: int | None = None
+) -> StressFootprintState:
+    shape = (n_contacts, n_envs)
+    return StressFootprintState(
+        port_distance=V(dtype=gs.qd_float, shape=(n_ports, n_contacts, n_envs)),
+        seed_distance=V(dtype=gs.qd_float, shape=(n_face_ports, n_contacts, n_envs) if n_face_ports is not None else ()),
+        status=V(dtype=gs.qd_int, shape=shape),
+        candidates=V(dtype=gs.qd_int, shape=shape),
+        samples=V(dtype=gs.qd_int, shape=shape),
+        maximum_distance=V(dtype=gs.qd_float, shape=shape),
+    )
+
+
+@qd.kernel
+def kernel_footprint_ports(
+    contact_state: StressContactState,
+    source_state: StressSourceState,
+    footprint_state: StressFootprintState,
+    surface_info: StressSurfaceInfo,
+    path_info: StressPathInfo,
+):
+    for i_c, i_b in qd.ndrange(contact_state.valid.shape[0], contact_state.valid.shape[1]):
+        footprint_state.status[i_c, i_b] = StressFootprintStatus.SUCCESS
+        footprint_state.candidates[i_c, i_b] = 0
+        footprint_state.samples[i_c, i_b] = 0
+        footprint_state.maximum_distance[i_c, i_b] = 0.0
+        if contact_state.valid[i_c, i_b]:
+            i_anchor = contact_state.anchor_face[i_c, i_b]
+            is_resolved = source_state.status[i_c, i_b] == StressSourceStatus.SUCCESS
+            is_resolved = is_resolved and 0 <= i_anchor < surface_info.face_origin.shape[0]
+            if not is_resolved:
+                footprint_state.status[i_c, i_b] = StressFootprintStatus.INVALID_SOURCE
+            else:
+                radius = contact_state.radius[i_c, i_b]
+                anchor = contact_state.center[i_c, i_b]
+                is_valid = radius > 0.0 and radius < qd.math.inf and qd.abs(anchor.sum()) < qd.math.inf
+                if not is_valid:
+                    footprint_state.status[i_c, i_b] = StressFootprintStatus.INVALID_INPUT
+                elif qd.static(len(footprint_state.seed_distance.shape) == 3):
+                    for i_a in range(path_info.face_ports.shape[1]):
+                        i_first = path_info.face_ports[i_anchor, i_a]
+                        footprint_state.seed_distance[i_a, i_c, i_b] = (path_info.positions[i_first] - anchor).norm()
+    for i_p, i_c, i_b in qd.ndrange(
+        path_info.positions.shape[0], contact_state.valid.shape[0], contact_state.valid.shape[1]
+    ):
+        distance = gs.qd_float(float("inf"))
+        if contact_state.valid[i_c, i_b] and footprint_state.status[i_c, i_b] == StressFootprintStatus.SUCCESS:
+            i_anchor = contact_state.anchor_face[i_c, i_b]
+            anchor = contact_state.center[i_c, i_b]
+            for i_a in range(path_info.face_ports.shape[1]):
+                i_first = path_info.face_ports[i_anchor, i_a]
+                seed_distance = gs.qd_float(0.0)
+                if qd.static(len(footprint_state.seed_distance.shape) == 3):
+                    seed_distance = footprint_state.seed_distance[i_a, i_c, i_b]
+                else:
+                    seed_distance = (path_info.positions[i_first] - anchor).norm()
+                candidate = seed_distance + path_info.distances[i_first, i_p]
+                distance = qd.min(distance, candidate)
+        footprint_state.port_distance[i_p, i_c, i_b] = distance
+
+
+@qd.func
+def func_footprint_distance(
+    i_q: int,
+    i_c: int,
+    i_b: int,
+    contact_state: StressContactState,
+    footprint_state: StressFootprintState,
+    stress_info: StressInfo,
+    surface_info: StressSurfaceInfo,
+    path_info: StressPathInfo,
+):
+    """Return a witnessed surface-path upper bound, with a checked planar shortcut."""
+    i_face = i_q // surface_info.shape.shape[0]
+    target = surface_info.positions[i_q]
+    return func_footprint_point_distance(
+        i_face, i_c, i_b, target, contact_state, footprint_state, stress_info, surface_info, path_info
+    )
+
+
+@qd.func
+def func_footprint_point_distance(
+    i_face: int,
+    i_c: int,
+    i_b: int,
+    target: qd.types.vector(3),
+    contact_state: StressContactState,
+    footprint_state: StressFootprintState,
+    stress_info: StressInfo,
+    surface_info: StressSurfaceInfo,
+    path_info: StressPathInfo,
+):
+    i_anchor = contact_state.anchor_face[i_c, i_b]
+    anchor = contact_state.center[i_c, i_b]
+    is_straight = func_surface_segment(i_anchor, i_face, anchor, target, stress_info, surface_info)
+    distance = gs.qd_float(float("inf"))
+    if is_straight:
+        distance = (target - anchor).norm()
+    else:
+        # A path crossing one actual shared edge has an exact two-triangle
+        # unfolding. Both segments stay inside their convex triangles. This
+        # removes port-spacing error without connecting separate sheets.
+        for i_edge in qd.static(range(3)):
+            if stress_info.surface_neighbors[i_anchor, i_edge] == i_face:
+                i_first = stress_info.surface_nodes[i_anchor, i_edge]
+                i_second = stress_info.surface_nodes[i_anchor, (i_edge + 1) % 3]
+                first = stress_info.vertices[i_first]
+                edge = stress_info.vertices[i_second] - first
+                length = edge.norm()
+                direction = edge / length
+                anchor_coordinate = (anchor - first).dot(direction)
+                target_coordinate = (target - first).dot(direction)
+                anchor_height = (anchor - first - anchor_coordinate * direction).norm()
+                target_height = (target - first - target_coordinate * direction).norm()
+                height = anchor_height + target_height
+                crossing = gs.qd_float(0.0)
+                if height > 0.0:
+                    crossing = (anchor_height * target_coordinate + target_height * anchor_coordinate) / height
+                crossing = qd.min(length, qd.max(0.0, crossing))
+                point = first + crossing * direction
+                distance = qd.min(distance, (anchor - point).norm() + (target - point).norm())
+        for i_t in range(path_info.face_ports.shape[1]):
+            i_port = path_info.face_ports[i_face, i_t]
+            candidate = footprint_state.port_distance[i_port, i_c, i_b]
+            # The final segment has nonnegative length, so this lower bound preserves the same minimum.
+            if candidate < distance:
+                candidate += (target - path_info.positions[i_port]).norm()
+                distance = qd.min(distance, candidate)
+    return distance, is_straight
+
+
+def create_surface_fan_tractions(
+    surface_info: StressSurfaceInfo,
+    n_contacts: int,
+    n_envs: int,
+    *,
+    coordinate_power: int = 2,
+    shared_support: bool = False,
+    surface_fan_frontier: bool = True,
+    source_priors: bool = False,
+    cached_acceptance: bool = False,
+) -> StressTractionState:
+    """Partition every boundary face about its closest point to the anchor.
+
+    The finite area rule resolves small neighboring patches. Geometry is
+    reconstructed from shared triangles and one barycentric center per face/contact,
+    rather than storing per-sample position, normal and P2 shape tensors.
+    A disk wholly inside one verified triangle uses a radius-scaled circular
+    rule. Other footprints use squared triangle coordinates to resolve
+    support close to edges. A power of one supplies linear coordinates.
+    """
+    n_faces = surface_info.face_origin.shape[0]
+    return create_tractions(
+        3 * surface_info.positions.shape[0],
+        n_contacts,
+        n_envs,
+        packed_samples=True,
+        fan_faces=n_faces,
+        fan_coordinate_power=coordinate_power,
+        shared_support=shared_support,
+        surface_fan_frontier=surface_fan_frontier,
+        source_priors=source_priors,
+        cached_acceptance=cached_acceptance,
+    )
+
+
+def kernel_surface_fan_profiles(
+    contact_state: StressContactState,
+    footprint_state: StressFootprintState,
+    traction_state: StressTractionState,
+    stress_info: StressInfo,
+    surface_info: StressSurfaceInfo,
+    path_info: StressPathInfo,
+    traction_info: StressTractionInfo,
+    epsilon: float,
+):
+    implementation = kernel_surface_fan_profiles_impl
+    if len(traction_state.frontier.indices.shape) == 3:
+        from .surface_frontier import kernel_surface_fan_profiles as implementation
+
+    implementation(
+        contact_state, footprint_state, traction_state, stress_info, surface_info, path_info, traction_info, epsilon
+    )
+
+
+@qd.kernel
+def kernel_surface_fan_profiles_impl(
+    contact_state: StressContactState,
+    footprint_state: StressFootprintState,
+    traction_state: StressTractionState,
+    stress_info: StressInfo,
+    surface_info: StressSurfaceInfo,
+    path_info: StressPathInfo,
+    traction_info: StressTractionInfo,
+    epsilon: float,
+):
+    for i_c, i_b in qd.ndrange(contact_state.valid.shape[0], contact_state.valid.shape[1]):
+        traction_state.sample_count[i_c, i_b] = 0
+        traction_state.fan_refined[i_c, i_b] = False
+        traction_state.circle.face[i_c, i_b] = -1
+        traction_state.circle.radius[i_c, i_b] = 0.0
+        traction_state.circle.refined[i_c, i_b] = False
+        traction_state.circle.focus[i_c, i_b] = qd.Vector.zero(gs.qd_float, 2)
+        if contact_state.valid[i_c, i_b] and footprint_state.status[i_c, i_b] == StressFootprintStatus.SUCCESS:
+            i_face = contact_state.anchor_face[i_c, i_b]
+            origin, edges = surface_info.face_origin[i_face], surface_info.face_edges[i_face]
+            anchor, radius = contact_state.center[i_c, i_b], contact_state.radius[i_c, i_b]
+            normal = -surface_info.face_normal[i_face]
+            roundoff = 128.0 * epsilon * (anchor.norm() + origin.norm() + edges[0, :].norm() + edges[1, :].norm())
+            inside = qd.abs((anchor - origin).dot(normal)) <= roundoff
+            vertices = qd.Matrix.rows([origin, origin + edges[0, :], origin + edges[1, :]])
+            for a in range(3):
+                edge = vertices[(a + 1) % 3, :] - vertices[a, :]
+                direction = normal.cross(edge).normalized()
+                if direction.dot(vertices[(a + 2) % 3, :] - vertices[a, :]) < 0.0:
+                    direction = -direction
+                inside = inside and (anchor - vertices[a, :]).dot(direction) >= radius + roundoff
+            # Any path leaving this convex triangle already spends at least
+            # R before its first boundary crossing. The complete intrinsic
+            # footprint is therefore this disk; nearby sheets cannot enter it.
+            if inside:
+                traction_state.circle.face[i_c, i_b] = i_face
+                traction_state.circle.radius[i_c, i_b] = radius
+    for i_f, i_c, i_b in qd.ndrange(
+        surface_info.face_origin.shape[0], contact_state.valid.shape[0], contact_state.valid.shape[1]
+    ):
+        bary = qd.Vector.zero(gs.qd_float, 3)
+        if contact_state.valid[i_c, i_b] and footprint_state.status[i_c, i_b] == StressFootprintStatus.SUCCESS:
+            _, bary = func_closest_triangle(i_f, contact_state.center[i_c, i_b], surface_info)
+        traction_state.fan_barycentric[i_f, i_c, i_b] = bary
+    for i_q, i_c, i_b in qd.ndrange(
+        traction_state.profile.shape[0], contact_state.valid.shape[0], contact_state.valid.shape[1]
+    ):
+        if contact_state.valid[i_c, i_b] and footprint_state.status[i_c, i_b] == StressFootprintStatus.SUCCESS:
+            anchor, radius = contact_state.center[i_c, i_b], contact_state.radius[i_c, i_b]
+            n = surface_info.gauss.shape[0]
+            i_circle = traction_state.circle.face[i_c, i_b]
+            i_sample = i_q
+            is_candidate = False
+            if i_circle >= 0:
+                is_candidate = i_q < n * n
+                i_sample = 3 * surface_info.positions.shape[0] + i_q
+            else:
+                i_face = i_q // (3 * n * n)
+                center_bary = traction_state.fan_barycentric[i_face, i_c, i_b]
+                origin, edges = surface_info.face_origin[i_face], surface_info.face_edges[i_face]
+                center = origin + center_bary[1] * edges[0, :] + center_bary[2] * edges[1, :]
+                is_candidate = (center - anchor).norm() < radius
+            if is_candidate:
+                i_face, bary = func_surface_fan_bary(i_sample, i_c, i_b, traction_state, traction_info)
+                origin, edges = surface_info.face_origin[i_face], surface_info.face_edges[i_face]
+                position = origin + bary[1] * edges[0, :] + bary[2] * edges[1, :]
+                weight, distance = gs.qd_float(0.0), gs.qd_float(float("inf"))
+                i_local = i_q % (n * n)
+                u, v = surface_info.gauss[i_local // n], surface_info.gauss[i_local % n]
+                power = traction_state.fan_coordinate_power[None]
+                if i_circle >= 0:
+                    qd.atomic_add(footprint_state.candidates[i_c, i_b], 1)
+                    distance = radius * u**power
+                    weight = 2.0 * qd.math.pi * radius * radius * power * u ** (2 * power - 1)
+                else:
+                    i_fan = (i_q // (n * n)) % 3
+                    # A zero-area edge fan must not acquire a spurious weight
+                    # through a coordinate round-trip.
+                    center_bary = traction_state.fan_barycentric[i_face, i_c, i_b]
+                    area = center_bary[(i_fan + 2) % 3] * edges[0, :].cross(edges[1, :]).norm()
+                    if area > 0.0 and (position - anchor).norm() < radius:
+                        qd.atomic_add(footprint_state.candidates[i_c, i_b], 1)
+                        distance, _ = func_footprint_point_distance(
+                            i_face,
+                            i_c,
+                            i_b,
+                            position,
+                            contact_state,
+                            footprint_state,
+                            stress_info,
+                            surface_info,
+                            path_info,
+                        )
+                        weight = area * u**power * power * power * u ** (power - 1) * v ** (power - 1)
+                if weight > 0.0 and distance < radius:
+                    weight *= surface_info.gauss_weights[i_local // n] * surface_info.gauss_weights[i_local % n]
+                    relative = distance / radius
+                    profile = weight * qd.exp(-0.5 * (relative / 0.45) ** 2) * (1.0 - relative * relative) ** 2
+                    i_slot = qd.atomic_add(traction_state.sample_count[i_c, i_b], 1)
+                    traction_state.sample_indices[i_slot, i_c, i_b] = i_sample
+                    traction_state.profile[i_slot, i_c, i_b] = profile
+                    qd.atomic_add(footprint_state.samples[i_c, i_b], 1)
+                    qd.atomic_max(footprint_state.maximum_distance[i_c, i_b], distance)
+    for i_c, i_b in qd.ndrange(contact_state.valid.shape[0], contact_state.valid.shape[1]):
+        if (
+            contact_state.valid[i_c, i_b]
+            and footprint_state.status[i_c, i_b] == StressFootprintStatus.SUCCESS
+            and footprint_state.samples[i_c, i_b] == 0
+        ):
+            footprint_state.status[i_c, i_b] = StressFootprintStatus.EMPTY_SUPPORT
+
+
+@qd.kernel
+def kernel_refine_failed_disks(
+    contact_state: StressContactState,
+    source_state: StressSourceState,
+    footprint_state: StressFootprintState,
+    traction_state: StressTractionState,
+    surface_info: StressSurfaceInfo,
+    traction_info: StressTractionInfo,
+    epsilon: float,
+):
+    """Refine unresolved single-source disks without changing their physical footprint or vector-traction law.
+
+    Only verified disks contained in one actual material triangle are repartitioned. Positive compression fixes
+    their required centroid and normal torque from the original wrench; shared supports retain their existing diagnostic route.
+    Successful fits retain their profiles and fitted state. The caller retries only refined unresolved fits and
+    applies the unchanged final original-point wrench, local-cone and elastic consistency checks. A required
+    compression centroid or normal torque outside the same disk's capacity is diagnosed using a continuous polar
+    ray with roundoff and original-point error allowances; the bound holds throughout the disk independently of sampling.
+    """
+    for i_c, i_b in qd.ndrange(contact_state.valid.shape[0], contact_state.valid.shape[1]):
+        first, last = func_traction_support_range(i_c, i_b, traction_state)
+        unresolved = traction_state.status[i_c, i_b] == StressTractionStatus.NUMERICAL_FAILURE
+        unresolved = unresolved or traction_state.status[i_c, i_b] == StressTractionStatus.SAMPLED_WRENCH_INFEASIBLE
+        i_face = traction_state.circle.face[i_c, i_b]
+        if contact_state.valid[i_c, i_b] and unresolved and first == i_c and last == i_c + 1 and i_face >= 0:
+            normal = -surface_info.face_normal[i_face]
+            compression = contact_state.force[i_c, i_b].dot(normal)
+            if compression > 0.0:
+                radius = traction_state.circle.radius[i_c, i_b]
+                centroid = normal.cross(source_state.anchor_moment[i_c, i_b]) / (compression * radius)
+                fraction = centroid.norm()
+                normal_torque = source_state.anchor_moment[i_c, i_b].dot(normal) / (compression * radius)
+                friction = contact_state.friction[i_c, i_b]
+                for i_test in range(2):
+                    violation = False
+                    force_ray, moment_ray = qd.Vector.zero(gs.qd_float, 3), qd.Vector.zero(gs.qd_float, 3)
+                    gap = gs.qd_float(0.0)
+                    if i_test == 0 and fraction > 1.0:
+                        violation = True
+                        force_ray = -0.5 * (1.0 + fraction) * normal
+                        moment_ray = -normal.cross(centroid / fraction)
+                        gap = fraction - 1.0
+                    if i_test == 1 and qd.abs(normal_torque) > friction:
+                        violation = True
+                        force_ray = -0.5 * (qd.abs(normal_torque) + friction) * normal
+                        moment_ray = (1.0 if normal_torque > 0.0 else -1.0) * normal
+                        gap = qd.abs(normal_torque) - friction
+                    if violation:
+                        ray_norm = qd.sqrt(force_ray.dot(force_ray) + moment_ray.dot(moment_ray))
+                        force_ray /= ray_norm
+                        moment_ray /= ray_norm
+                        ray = qd.Vector(
+                            [
+                                force_ray[0],
+                                force_ray[1],
+                                force_ray[2],
+                                moment_ray[0],
+                                moment_ray[1],
+                                moment_ray[2],
+                            ]
+                        )
+                        scale = traction_state.scale[i_c, i_b]
+                        margin = force_ray.dot(contact_state.force[i_c, i_b])
+                        margin += moment_ray.dot(source_state.anchor_moment[i_c, i_b]) / radius
+                        margin /= scale
+                        offset = (contact_state.position[i_c, i_b] - contact_state.center[i_c, i_b]) / radius
+                        allowance = (force_ray + moment_ray.cross(offset)).norm() + moment_ray.norm()
+                        allowance *= 1e-8 * contact_state.force[i_c, i_b].norm() / scale
+                        edges = surface_info.face_edges[i_face]
+                        roundoff = (
+                            512.0
+                            * epsilon
+                            * (
+                                1.0
+                                + (contact_state.center[i_c, i_b].norm() + edges[0, :].norm() + edges[1, :].norm())
+                                / radius
+                            )
+                            * (1.0 + friction)
+                        )
+                        bound = -0.5 * gap / ray_norm
+                        if bound < -roundoff and margin > allowance + roundoff:
+                            traction_state.status[i_c, i_b] = StressTractionStatus.CONTINUOUS_WRENCH_INFEASIBLE
+                            traction_state.certificate[i_c, i_b] = ray
+                            traction_state.certificate_margin[i_c, i_b] = margin
+                refine_fraction = fraction
+                if friction > 0.0:
+                    refine_fraction = qd.max(refine_fraction, qd.abs(normal_torque) / friction)
+                if (
+                    traction_state.status[i_c, i_b] != StressTractionStatus.CONTINUOUS_WRENCH_INFEASIBLE
+                    and refine_fraction < 1.0
+                    and 9 * surface_info.gauss.shape[0] ** 2 <= traction_state.profile.shape[0]
+                ):
+                    tangent = surface_info.face_edges[i_face][0, :].normalized()
+                    second = normal.cross(tangent)
+                    theta = gs.qd_float(0.0)
+                    if fraction > 256.0 * epsilon * (1.0 + contact_state.center[i_c, i_b].norm() / radius):
+                        theta = qd.atan2(centroid.dot(second), centroid.dot(tangent))
+                    traction_state.circle.focus[i_c, i_b] = qd.Vector(
+                        [
+                            qd.min(1.0 - 1e-12, refine_fraction),
+                            theta,
+                        ]
+                    )
+                    traction_state.circle.refined[i_c, i_b] = True
+                    traction_state.sample_count[i_c, i_b] = 9 * surface_info.gauss.shape[0] ** 2
+                    footprint_state.samples[i_c, i_b] = traction_state.sample_count[i_c, i_b]
+                    footprint_state.candidates[i_c, i_b] = traction_state.sample_count[i_c, i_b]
+                    footprint_state.maximum_distance[i_c, i_b] = 0.0
+    for i_q, i_c, i_b in qd.ndrange(
+        9 * surface_info.gauss.shape[0] ** 2, contact_state.valid.shape[0], contact_state.valid.shape[1]
+    ):
+        if traction_state.circle.refined[i_c, i_b]:
+            distance, _, jacobian = func_circle_panel(i_q, i_c, i_b, traction_state, traction_info)
+            n = surface_info.gauss.shape[0]
+            local = i_q % (n * n)
+            radius = traction_state.circle.radius[i_c, i_b]
+            profile = radius * radius * distance * jacobian
+            profile *= surface_info.gauss_weights[local // n] * surface_info.gauss_weights[local % n]
+            profile *= qd.exp(-0.5 * (distance / 0.45) ** 2) * (1.0 - distance * distance) ** 2
+            traction_state.profile[i_q, i_c, i_b] = profile
+            traction_state.sample_indices[i_q, i_c, i_b] = 3 * traction_info.positions.shape[0] + i_q
+            qd.atomic_max(footprint_state.maximum_distance[i_c, i_b], radius * distance)
+
+
+def create_anchor_fan_tractions(
+    surface_info: StressSurfaceInfo,
+    n_contacts: int,
+    n_envs: int,
+    *,
+    compact: bool = False,
+    packed: bool = False,
+    shared_support: bool = False,
+    source_priors: bool = False,
+    cached_acceptance: bool = False,
+) -> StressTractionState:
+    """Integrate the witnessed face as three finite triangles incident to its anchor.
+
+    Other faces retain the same shared quadrature. This local partition adds
+    two face-sized rules, preserves physical radius/profile and uses no point
+    load. The dense proof layout remains separate from live contact packing.
+    """
+    n_samples = surface_info.positions.shape[0] + 2 * surface_info.shape.shape[0]
+    return create_tractions(
+        n_samples,
+        n_contacts,
+        n_envs,
+        local_samples=True,
+        local_sample_count=3 * surface_info.shape.shape[0] if compact else None,
+        packed_samples=packed,
+        shared_support=shared_support,
+        source_priors=source_priors,
+        cached_acceptance=cached_acceptance,
+    )
+
+
+@qd.func
+def func_anchor_fan_sample(
+    i_q: int,
+    i_c: int,
+    i_b: int,
+    contact_state: StressContactState,
+    stress_info: StressInfo,
+    surface_info: StressSurfaceInfo,
+):
+    n_quadrature = surface_info.shape.shape[0]
+    n_shared = surface_info.positions.shape[0]
+    i_anchor = contact_state.anchor_face[i_c, i_b]
+    i_face, i_sample, i_fan = i_q // n_quadrature, i_q % n_quadrature, 0
+    if i_q >= n_shared:
+        i_face = i_anchor
+        i_fan = 1 + (i_q - n_shared) // n_quadrature
+    anchor = contact_state.center[i_c, i_b]
+    normal = -surface_info.face_normal[i_face]
+    position = qd.Vector.zero(gs.qd_float, 3)
+    basis = qd.Vector.zero(gs.qd_float, 6)
+    area_weight = gs.qd_float(0.0)
+    i_local = -1
+    if i_face == i_anchor:
+        i_local = i_fan * n_quadrature + i_sample
+        n = surface_info.gauss.shape[0]
+        u, v = surface_info.gauss[i_sample // n], surface_info.gauss[i_sample % n]
+        local = surface_info.face_dual[i_face] @ (anchor - surface_info.face_origin[i_face])
+        anchor_bary = qd.Vector([1.0 - local[0] - local[1], local[0], local[1]])
+        bary = (1.0 - u) * anchor_bary
+        bary[i_fan] += u * (1.0 - v)
+        bary[(i_fan + 1) % 3] += u * v
+        i_first = stress_info.surface_nodes[i_face, i_fan]
+        i_second = stress_info.surface_nodes[i_face, (i_fan + 1) % 3]
+        first, second = stress_info.vertices[i_first], stress_info.vertices[i_second]
+        position = (1.0 - u) * anchor + u * (1.0 - v) * first + u * v * second
+        area_weight = (first - anchor).cross(second - anchor).norm() * u
+        area_weight *= surface_info.gauss_weights[i_sample // n] * surface_info.gauss_weights[i_sample % n]
+        basis = qd.Vector(
+            [
+                bary[0] * (2.0 * bary[0] - 1.0),
+                bary[1] * (2.0 * bary[1] - 1.0),
+                bary[2] * (2.0 * bary[2] - 1.0),
+                4.0 * bary[0] * bary[1],
+                4.0 * bary[0] * bary[2],
+                4.0 * bary[1] * bary[2],
+            ]
+        )
+    else:
+        position = surface_info.positions[i_q]
+        basis = surface_info.shape[i_sample]
+        area_weight = surface_info.weights[i_q]
+    return position, normal, basis, area_weight, i_face, i_local
+
+
+@qd.kernel
+def kernel_anchor_fan_profiles(
+    contact_state: StressContactState,
+    footprint_state: StressFootprintState,
+    traction_state: StressTractionState,
+    stress_info: StressInfo,
+    surface_info: StressSurfaceInfo,
+    path_info: StressPathInfo,
+):
+    for i_c, i_b in qd.ndrange(contact_state.valid.shape[0], contact_state.valid.shape[1]):
+        if qd.static(len(traction_state.sample_indices.shape) == 3):
+            traction_state.sample_count[i_c, i_b] = 0
+        else:
+            traction_state.sample_count[i_c, i_b] = traction_state.profile.shape[0]
+        if qd.static(len(traction_state.sample_faces.shape) == 2):
