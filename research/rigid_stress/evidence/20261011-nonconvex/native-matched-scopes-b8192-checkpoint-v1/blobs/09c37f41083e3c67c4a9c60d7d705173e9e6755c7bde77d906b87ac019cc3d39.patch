+    "$RIGID_STRESS_ENV/bin/python" examples/speed_benchmark/rigid_stress.py --scope "$task_scope" --envs "$task_batch" --warmup 600 --steps 1280 --repetitions 3 --minimum-seconds 0 --seed "$task_seed" --varied --contact-model intrinsic --intrinsic-load-partition body_source_prior --contact-block-size 4 --egg-geometry mesh64 --collision-method gjk --contact-patch on --compact-log --source-revision "$(git rev-parse HEAD)+matched-bank-v1" "${task_args[@]}" --output "$task_run/result.json" > "$task_run/benchmark.log" 2>&1 || task_failed=1
+    echo "$task_failed" > "$task_run/returncode.txt"
+    sha256sum "${task_sources[@]}" > "$task_run/source-after.sha256"
+    cmp "$task_run/source.sha256" "$task_run/source-after.sha256"
+    sha256sum "$task_bank" > "$task_run/conditions-after.sha256"
+    if [[ "$task_scope" != rigid ]]; then cmp "$task_run/conditions-before.sha256" "$task_run/conditions-after.sha256"; fi
