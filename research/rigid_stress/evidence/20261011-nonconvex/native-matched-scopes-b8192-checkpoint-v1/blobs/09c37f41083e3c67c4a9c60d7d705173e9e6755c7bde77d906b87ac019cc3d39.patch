+                                qd.max(i_la_q, i_lb_q),
+                                collider_state.contact_data.geom_a[i_q, i_b],
+                                collider_state.contact_data.geom_b[i_q, i_b],
+                                collider_state.contact_proj_v[i_q, i_b],
+                            ],
+                            dt=gs.qd_float,
