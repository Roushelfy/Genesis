+                        mean_normal_x * mean_normal_x + mean_normal_y * mean_normal_y + mean_normal_z * mean_normal_z
+                    )
+
+                    max_in_plane_r2 = gs.qd_float(0.0)
+                    coplanar = mean_normal_norm > EPS
