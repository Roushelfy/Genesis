+@qd.kernel
+def kernel_footprint_profiles(
+    contact_state: StressContactState,
+    footprint_state: StressFootprintState,
+    traction_state: StressTractionState,
+    stress_info: StressInfo,
+    surface_info: StressSurfaceInfo,
