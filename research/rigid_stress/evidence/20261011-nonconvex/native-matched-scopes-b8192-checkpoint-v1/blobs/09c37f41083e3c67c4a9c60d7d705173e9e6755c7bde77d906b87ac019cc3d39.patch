+@qd.func
+def func_scatter_faces(
+    contacts: StressContactState,
+    state: StressState,
+    info: StressInfo,
+    surface: StressSurfaceInfo,
+    workspace: StressScatterWorkspace,
+    cached_bounds: qd.template(),
+    reuse_moments: qd.template() = False,
+):
+    if qd.static(not reuse_moments):
