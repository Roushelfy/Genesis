+        if not isinstance(self.sim.coupler, SAPCoupler):
+            self._is_forward_pos_updated = not self._enable_mujoco_compatibility
+            self._is_forward_vel_updated = not self._enable_mujoco_compatibility
+            if self._requires_grad:
