+                            512.0
+                            * epsilon
+                            * (
+                                1.0
+                                + (contact_state.center[i_c, i_b].norm() + edges[0, :].norm() + edges[1, :].norm())
+                                / radius
+                            )
+                            * (1.0 + friction)
+                        )
+                        bound = -0.5 * gap / ray_norm
+                        if bound < -roundoff and margin > allowance + roundoff:
