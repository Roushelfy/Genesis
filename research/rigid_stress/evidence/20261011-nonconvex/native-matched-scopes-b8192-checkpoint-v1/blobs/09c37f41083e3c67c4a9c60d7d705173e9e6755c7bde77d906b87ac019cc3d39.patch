+                                    hessian = qd.Matrix.zero(gs.qd_float, 6, 6)
+                                    if qd.static(boundary_witnesses):
+                                        trial_energy, gradient, hessian = func_boundary_wrench_penalty(
+                                            i_c,
+                                            i_b,
+                                            proposal,
+                                            target,
+                                            penalty,
+                                            contact_state,
+                                            traction_state,
+                                            traction_info,
+                                            epsilon,
+                                        )
+                                    else:
+                                        trial_energy, gradient, hessian = func_wrench_polar_penalty(
+                                            i_c,
+                                            i_b,
+                                            proposal,
+                                            target,
+                                            penalty,
