+                                        collider_state.contact_keep[i_cb, i_b] = 1
+
+                    i_cb_start = i_cb_end
+
+                # Phase 3: compact contact_sort_idx by squeezing out dropped slots.
+                i_cw = n_hib
+                for i_cr in range(n_hib, n_con):
