+                else:
+                    msg_infos.append(f"Dimension {i} consistent with required size {size}")
+        if msg_infos:
+            msg_err += f" {' & '.join(msg_infos)}."
+        else:
+            msg_err += f" Expected shape: {tuple(expected_shape)}."
+        gs.raise_exception_from(msg_err, e)
+
+    return tensor_
+
