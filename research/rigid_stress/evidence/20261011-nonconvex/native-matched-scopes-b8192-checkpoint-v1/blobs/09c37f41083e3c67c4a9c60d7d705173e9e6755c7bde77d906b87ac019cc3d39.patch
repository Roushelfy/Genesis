+    fixed: StrictBool = False
+    batch_fixed_verts: StrictBool = True
+    contype: StrictInt = Field(default=0xFFFF, ge=0, le=0xFFFFFFFF)
+    conaffinity: StrictInt = Field(default=0xFFFF, ge=0, le=0xFFFFFFFF)
