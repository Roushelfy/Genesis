+                            axis_y = gs.qd_float(1.0)
+                            axis_z = gs.qd_float(0.0)
+                        elif abs_mean_normal_z < abs_mean_normal_x and abs_mean_normal_z <= abs_mean_normal_y:
+                            axis_x = gs.qd_float(0.0)
+                            axis_y = gs.qd_float(0.0)
+                            axis_z = gs.qd_float(1.0)
