+                if budget_scale == 0.0:
+                    budget_scale = scale
+                budget = 1e-8 * budget_scale
+                if not cone_valid or force_error > budget or moment_error > budget * contact_state.radius[i_c, i_b]:
+                    status = 40
+            raw_contacts.status[i_raw, i_b] = status
+
