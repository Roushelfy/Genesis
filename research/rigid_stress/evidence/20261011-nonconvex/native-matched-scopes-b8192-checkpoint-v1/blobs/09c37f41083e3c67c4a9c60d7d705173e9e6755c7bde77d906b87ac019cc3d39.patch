+"$RIGID_STRESS_ENV/bin/python" -m pytest -p native_contact_graph_test_plugin_v1 -n 0 --backend "$task_backend" --tb=short -q --junitxml "$task_run/report.xml" -o junit_family=legacy "${task_tests[@]}" > "$task_run/tests.log" 2>&1 || task_failed=1
