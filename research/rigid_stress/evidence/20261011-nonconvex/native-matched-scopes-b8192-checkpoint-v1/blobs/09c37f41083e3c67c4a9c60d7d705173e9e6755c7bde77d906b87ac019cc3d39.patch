+            if qd.static(collider_static_config.has_terrain):
+                if dyn_info.geoms.type[i_ga] == gs.GEOM_TYPE.TERRAIN:
+                    i_ga, i_gb = i_gb, i_ga
+
+                if dyn_info.geoms.type[i_gb] == gs.GEOM_TYPE.TERRAIN:
+                    func_contact_mpr_terrain(
+                        i_ga,
+                        i_gb,
+                        i_b,
+                        geoms_init_AABB,
+                        dyn_state,
+                        collider_state,
+                        mpr_state,
+                        dyn_info,
+                        rigid_info,
+                        collider_info,
+                        rigid_config,
