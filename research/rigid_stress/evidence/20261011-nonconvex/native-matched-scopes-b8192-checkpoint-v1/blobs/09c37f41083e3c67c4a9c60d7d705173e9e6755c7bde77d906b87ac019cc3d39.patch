+class P2Shell:
+    def __init__(
+        self,
+        xyz: np.ndarray,
+        tetrahedra: np.ndarray,
+        outer: np.ndarray,
+        young: float,
+        poisson: float,
+        density: float,
+        layers: int,
+        ordering: str = "mmd",
+        factor_backend: str = "superlu",
+    ) -> None:
+        if young <= 0 or density <= 0 or not -1 < poisson < 0.5:
+            raise ValueError("A positive material modulus/density and admissible Poisson ratio are required")
+        start = perf_counter()
