+                        max_radius_sq_l = gs.qd_float(0.0)
+                        i_cb_ = i_cb_start + tid
+                        while i_cb_ < i_cb_end:
+                            i_pc = collider_state.contact_sort_idx[i_cb_, i_b]
+                            pos_c = collider_state.contact_data.pos[i_pc, i_b]
