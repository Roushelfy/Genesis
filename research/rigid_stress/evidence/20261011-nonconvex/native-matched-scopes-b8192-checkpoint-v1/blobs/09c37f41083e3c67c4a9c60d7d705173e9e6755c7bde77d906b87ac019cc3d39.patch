+                iout_chunks = (iout[..., 0], iout[..., 1], iout[..., 2], iout[..., 3])
+                fout_chunks = (fout[..., 0], fout[..., 1:4], fout[..., 4:7], fout[..., 7:10], fout[..., 10])
+                values = (*iout_chunks, *fout_chunks)
+            elif n_contacts_max >= n_envs:
