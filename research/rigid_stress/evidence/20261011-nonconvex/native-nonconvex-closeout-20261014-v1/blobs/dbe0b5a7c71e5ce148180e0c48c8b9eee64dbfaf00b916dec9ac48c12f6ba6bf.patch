+            failure.contact[i_b] = -1
+            failure.status[i_b] = 0
+            failure.radius[i_b] = 0.0
+            failure.friction[i_b] = 0.0
+            failure.position[i_b] = qd.Vector.zero(gs.qd_float, 3)
