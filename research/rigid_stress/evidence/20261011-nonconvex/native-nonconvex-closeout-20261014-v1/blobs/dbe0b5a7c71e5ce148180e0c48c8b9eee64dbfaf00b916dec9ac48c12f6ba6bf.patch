+            data["lower"] = tuple((pos - 0.5 * size).tolist())
+            data["upper"] = tuple((pos + 0.5 * size).tolist())
+
+        else:
+            gs.raise_exception("`lower` and `upper` must be jointly specified.")
+
+        return data
