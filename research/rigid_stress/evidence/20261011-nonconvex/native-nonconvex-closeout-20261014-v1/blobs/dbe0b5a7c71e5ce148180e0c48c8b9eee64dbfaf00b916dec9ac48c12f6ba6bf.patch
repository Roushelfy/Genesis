+class StressTractionStatus(IntEnum):
+    SUCCESS = 0
+    INVALID_INPUT = 1
+    UNRESOLVED_INTEGRATION = 2
+    NUMERICAL_FAILURE = 3
+    SAMPLED_WRENCH_INFEASIBLE = 4
+    CONTINUOUS_FORCE_INFEASIBLE = 5
+    CONTINUOUS_WRENCH_INFEASIBLE = 6
