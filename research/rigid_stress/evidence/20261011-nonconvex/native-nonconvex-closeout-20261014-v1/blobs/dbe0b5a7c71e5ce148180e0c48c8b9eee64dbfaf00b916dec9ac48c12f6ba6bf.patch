+        for i in range(6):
+            for j in range(i + 1):
+                value = gram[i, j]
+                for k in range(j):
+                    value -= lower[i, k] * lower[j, k]
+                if i == j:
+                    lower[i, j] = qd.sqrt(value)
+                else:
+                    lower[i, j] = value / lower[j, j]
