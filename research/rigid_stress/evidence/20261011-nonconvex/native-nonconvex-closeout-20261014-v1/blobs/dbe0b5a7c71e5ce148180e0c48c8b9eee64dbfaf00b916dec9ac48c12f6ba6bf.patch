+            and footprint_state.status[i_c, i_b] == StressFootprintStatus.SUCCESS
+            and (footprint_state.samples[i_c, i_b] == 0)
+        ):
+            footprint_state.status[i_c, i_b] = StressFootprintStatus.EMPTY_SUPPORT
+
