+                        normal_center = closing_normal
+                        seg_len = closing_dir.norm()
+                        depth_b = sdf.sdf_func_ray_exit_distance(
+                            j_gb,
+                            jb_center_world,
+                            closing_normal,
+                            seg_len,
+                            tolerance,
+                            jb_pos,
+                            jb_quat,
+                            dyn_info,
+                            collider_info,
+                        )
+                        depth_a = sdf.sdf_func_ray_exit_distance(
+                            j_ga,
+                            ja_center_world,
+                            -closing_normal,
+                            seg_len,
+                            tolerance,
+                            ja_pos,
+                            ja_quat,
+                            dyn_info,
+                            collider_info,
