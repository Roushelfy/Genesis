+@dataclasses.dataclass(eq=True, kw_only=False, frozen=True)
+class MPRInfo:
+    kind: ClassVar[DataKind] = DataKind.CONSTANT
+
+    CCD_EPS: qd.Tensor
+    CCD_TOLERANCE: qd.Tensor
+    CCD_ITERATIONS: qd.Tensor
+    CCD_EXTRAPOLATION_TOL: qd.Tensor
+
+
+def get_mpr_info(**kwargs):
