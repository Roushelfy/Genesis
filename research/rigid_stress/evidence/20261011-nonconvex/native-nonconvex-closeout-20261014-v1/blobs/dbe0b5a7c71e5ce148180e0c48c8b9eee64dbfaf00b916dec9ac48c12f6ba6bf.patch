+    for task_variant in native sparse_pack; do
+        task_case="$task_run/$task_scope/$task_variant"
+        mkdir -p "$task_case/tmp"
+        export TMPDIR="$task_case/tmp"
+        export QD_OFFLINE_CACHE_FILE_PATH="$task_case/cache/quadrants" GS_CACHE_FILE_PATH="$task_case/cache/genesis"
+        task_driver=(examples/speed_benchmark/rigid_stress.py)
+        if [[ "$task_variant" == sparse_pack ]]; then task_driver=("$task_root/probe_sparse_contact_pack_v2.py" benchmark); fi
+        "$RIGID_STRESS_ENV/bin/python" "${task_driver[@]}" --scope "$task_scope" --envs 32 --warmup 600 --steps "$task_steps" --repetitions 3 --minimum-seconds 10 --seed 623101 --varied --contact-model intrinsic --intrinsic-support pair_union --contact-block-size 4 --egg-geometry mesh64 --collision-method gjk --contact-patch on --conditions "$task_conditions" --compact-log --source-revision "$task_revision+native-warm-tractions+parallel-clear-$task_variant" --output "$task_case/result.json" > "$task_case/benchmark.log" 2>&1 || task_failed=1
+    done
+done
+sha256sum "${task_sources[@]}" > "$task_run/source-after.sha256"
+cmp "$task_run/source.sha256" "$task_run/source-after.sha256"
+exit "$task_failed"
