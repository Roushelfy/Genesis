+#!/usr/bin/env bash
+set -euo pipefail
+cd /mnt/home/zhaofeng/workspace/Genesis/.worktrees/rigid-stress-refinement
+source research/rigid_stress/scripts/cluster_env.sh
+task_root="$RIGID_STRESS_DATA_ROOT/runs/20261011-nonconvex"
+task_run="$task_root/native-cooperative-kernels-v1"
+test ! -e "$task_run"
+mkdir -p "$task_run/tmp" "$task_run/source"
+export TMPDIR="$task_run/tmp" PYTHONUNBUFFERED=1
+export QD_KERNEL_PROFILER=1
+task_conditions="$task_root/original-point-scalar-b32-profile-v1/conditions.npz"
+task_sources=(genesis/engine/solvers/rigid/stress/*.py genesis/options/{rigid_stress,morphs}.py examples/rigid/{franka_egg_stress,egg_stress_controller}.py examples/speed_benchmark/rigid_stress.py examples/rigid/assets/hollow_egg/level1/elastic.npz "$task_conditions" "$task_root/run_native_cooperative_kernels_v1.sh")
+sha256sum "${task_sources[@]}" > "$task_run/source.sha256"
+cp --parents "${task_sources[@]}" "$task_run/source"
+hostname > "$task_run/node.txt"
+nvidia-smi --query-gpu=name,memory.total,driver_version,uuid --format=csv > "$task_run/hardware.csv"
+task_failed=0
+for task_variant in scalar cooperative; do
+    mkdir -p "$task_run/$task_variant/tmp"
+    export TMPDIR="$task_run/$task_variant/tmp"
+    export QD_OFFLINE_CACHE_FILE_PATH="$task_run/$task_variant/cache/quadrants" GS_CACHE_FILE_PATH="$task_run/$task_variant/cache/genesis"
+    task_extra=()
+    if [[ "$task_variant" == scalar ]]; then task_extra+=(--serial-tractions); fi
+    "$RIGID_STRESS_ENV/bin/python" examples/speed_benchmark/rigid_stress.py --scope profile --envs 32 --warmup 600 --steps 128 --repetitions 3 --minimum-seconds 10 --seed 623101 --varied --contact-model intrinsic --intrinsic-support pair_union --contact-block-size 4 --egg-geometry mesh64 --collision-method gjk --contact-patch on --conditions "$task_conditions" --compact-log --source-revision "$(git rev-parse HEAD)+native-cooperative" --output "$task_run/$task_variant/result.json" "${task_extra[@]}" > "$task_run/$task_variant/benchmark.log" 2>&1 || task_failed=1
+done
+sha256sum "${task_sources[@]}" > "$task_run/source-after.sha256"
+cmp "$task_run/source.sha256" "$task_run/source-after.sha256"
+exit "$task_failed"
